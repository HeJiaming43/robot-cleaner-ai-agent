# 复制为 .env 后按需填写；.env 已在 .gitignore 中，不会提交
# 加载方式：export $(grep -v '^#' .env | xargs)  （或使用 IDE / 容器注入）

# 必填：通义千问 DashScope Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：知识库管理页口令。未配置时该页为只读，上传与重建按钮禁用
KB_ADMIN_PASSWORD=change-me-before-deploy

# 可选：日志级别（默认 INFO，写入文件为 DEBUG）
# LOG_LEVEL=INFO
